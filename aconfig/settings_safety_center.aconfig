package: "com.android.settings.flags"
container: "system_ext"

flag {
  name: "enable_safety_center_new_ui"
  namespace: "safety_center"
  description: "Enables the new Safety Center UI in Settings"
  bug: "425902698"
}

flag {
  name: "move_safety_source_refresh_to_background"
  namespace: "safety_center"
  description: "Moves the Safety Center source refresh to the background"
  bug: "420734103"
}

flag {
  name: "enable_binary_transparency_in_safety_center"
  namespace: "hardware_backed_security"
  description: "Enables the binary transparency option in Safety Center"
  bug: "458810078"
}
