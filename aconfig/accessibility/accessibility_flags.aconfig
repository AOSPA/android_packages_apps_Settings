  bug: "421227414"
}

flag {
  name: "catalyst_autoclick_screen"
  namespace: "accessibility"
  description: "Migrate autoclick screen to the Catalyst infrastructure"
  bug: "440382182"
}

flag {
  name: "catalyst_dark_ui_mode"
  namespace: "accessibility"
  description: "Migrate dark mode screen to the Catalyst infrastructure"
  bug: "337243099"
}

flag {
  name: "catalyst_edit_shortcuts"
  namespace: "accessibility"
  description: "Migrate edit shortcuts screen to the Catalyst infrastructure"
  bug: "440383851"
}

flag {
  name: "catalyst_flash_notifications"
  namespace: "accessibility"
  description: "Migrate flash notification screen to the Catalyst infrastructure"
  bug: "337243568"
}

flag {
  name: "catalyst_hearing_devices"
  namespace: "accessibility"
  description: "Migrate hearing device screen to the Catalyst infrastructure"
  bug: "337244007"
}

flag {
  name: "catalyst_caption_preferences_screen"
  namespace: "accessibility"
  description: "Migrate caption preferences screen to Catalyst infrastructure"
  bug: "440381963"
}

flag {
  name: "catalyst_time_to_take_action_screen"
  namespace: "accessibility"
  description: "Migrate time to take action screen to Catalyst infrastructure"
  bug: "440382902"
}

flag {
  name: "catalyst_timing_controls_screen"
  namespace: "accessibility"
  description: "Migrate timing controls screen to Catalyst infrastructure"
  bug: "440381971"
}

flag {
  name: "check_prebundled_is_preinstalled"
  namespace: "accessibility"
  description: "Checks that all 'prebundled' components, used for grouping, are also preinstalled"
  bug: "353888087"
  metadata {
    purpose: PURPOSE_BUGFIX
  }
}

flag {
  name: "desktop_magnification_settings_polish"
  namespace: "accessibility"
  description: "Enables polish of magnification settings related to input form factors (touch and keyboard)."
  bug: "422204290"
  metadata {
    purpose: PURPOSE_BUGFIX
  }
}

flag {
  name: "enable_color_contrast_control"
  namespace: "accessibility"
  description: "Allows users to control color contrast in the Accessibility settings page."
  bug: "246577325"
}

flag {
    name: "enable_edt_app_exceptions"
    namespace: "accessibility"
    description: "Allow users to opt-out selected apps from Expanded Dark Theme."
    bug: "448469020"
}

flag {
    name: "enable_inset_focus_rings_in_suw_read_only"
    namespace: "accessibility"
    description: "Decides whether to enable inset focus rings in Accessibility surfaces during the SuW."
    bug: "484084632"
    is_fixed_read_only: true
    metadata {
      purpose: PURPOSE_BUGFIX
    }
}

flag {
  name: "enable_magnification_focus_following_dialog"
  namespace: "accessibility"
  description: "Decides whether to show the magnification focus following dialog in Settings app."
  bug: "388336111"
}

flag {
  name: "enable_magnification_mode_chooser_fragment"
  namespace: "accessibility"
  description: "Enables the magnification mode chooser fragment instead of the legacy dialog UI."
  bug: "456047460"
  metadata {
    purpose: PURPOSE_BUGFIX
  }
}

flag {
    name: "enable_setuplib_in_a11y_setup_page"
    namespace: "accessibility"
    description: "Decides whether to use new accessibility setup page uses the SetupLib implementation."
    bug: "407080818"
}

flag {
    name: "floating_menu_transparency_slider_announces_disabled"
    namespace: "accessibility"
    description: "updates state description so slider handle reads 'disabled' when the setting is disabled."
    bug: "456649436"
    metadata {
      purpose: PURPOSE_BUGFIX
    }
}

flag {
  name: "never_restrict_accessibility_activity"
  namespace: "accessibility"
  description: "Stops possibly restricting AccessibilityActivityPreferences"
  bug: "331990900"
  metadata {
    purpose: PURPOSE_BUGFIX
  }
}

flag {
  name: "preferred_shortcut_filters_navigation_mode"
  namespace: "accessibility"
  description: "Retrieving a user's preferred shortcuts filters out types that aren't available in the current navigation mode."
  bug: "488115037"
  metadata {
    purpose: PURPOSE_BUGFIX
  }
}

flag {
  name: "text_cursor_blinking_user_setting"
  namespace: "accessibility"
  description: "Moves the text cursor blinking setting to the Color and Motion settings page."
  bug: "405251212"
  metadata {
    purpose: PURPOSE_BUGFIX
  }
}
