flag {
  name: "desktop_magnification_settings_polish"
  namespace: "accessibility"
  description: "Enables polish of magnification settings related to input form factors (touch and keyboard)."
  bug: "422204290"
  metadata {
    purpose: PURPOSE_BUGFIX
  }
}

flag {
  name: "enable_color_contrast_control"
  namespace: "accessibility"
  description: "Allows users to control color contrast in the Accessibility settings page."
  bug: "246577325"
}

flag {
    name: "enable_disability_support"
    namespace: "accessibility"
    description: "Use disability support for accessibility"
    bug: "419387108"
}

flag {
    name: "enable_edt_app_exceptions"
    namespace: "accessibility"
    description: "Allow users to opt-out selected apps from Expanded Dark Theme."
    bug: "448469020"
}

flag {
  name: "enable_magnification_focus_following_dialog"
  namespace: "accessibility"
  description: "Decides whether to show the magnification focus following dialog in Settings app."
  bug: "388336111"
}

flag {
  name: "enable_magnification_mode_chooser_fragment"
  namespace: "accessibility"
  description: "Enables the magnification mode chooser fragment instead of the legacy dialog UI."
  bug: "456047460"
  metadata {
    purpose: PURPOSE_BUGFIX
  }
}

flag {
    name: "enable_setuplib_in_a11y_setup_page"
    namespace: "accessibility"
    description: "Decides whether to use new accessibility setup page uses the SetupLib implementation."
    bug: "407080818"
}

flag {
  name: "never_restrict_accessibility_activity"
  namespace: "accessibility"
  description: "Stops possibly restricting AccessibilityActivityPreferences"
  bug: "331990900"
  metadata {
    purpose: PURPOSE_BUGFIX
  }
}

flag {
  name: "voice_access_locale_notifications"
  namespace: "accessibility"
  description: "Provides notification to users when the chosen locale doesn't have an associated model."
  bug: "453531997"
}
